# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.env
venv/
env/

# ── YOLO / ML model weights (very large – download via the app's Model Hub) ──
yolo-coco/yolov3.weights
yolo-coco/yolov3-tiny.weights

# ── OpenH264 DLL (downloaded automatically at runtime) ───────────────────────
openh264-*.dll

# ── Runtime output directories ───────────────────────────────────────────────
processed_media/
uploads/

# ── MobileNet SSD Caffe model weights (large binaries) ──────────────────────
real-time-object-detection/*.caffemodel

# ── Node / Frontend ──────────────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.local

# ── Editor / OS ──────────────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
